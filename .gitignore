# Generated by Cargo
# will have compiled files and executables
debug
target

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

# Generated by cargo mutants
# Contains mutation testing data
**/mutants.out*/

# RustRover
#  JetBrains specific template is maintained in a separate JetBrains.gitignore that can
#  be found at https://github.com/github/gitignore/blob/main/Global/JetBrains.gitignore
#  and can be added to the global gitignore or merged into this file.  For a more nuclear
#  option (not recommended) you can uncomment the following to ignore the entire idea folder.
#.idea/


# Added by cargo

/target

# Staging build trees. A second `CARGO_TARGET_DIR` next to `target/` is how a
# rebuild gets staged without disturbing the one a running daemon was built
# from, and it is as large and as disposable as `target/` itself.
/target-*

# Packaged release archives (`make package`/`dist`)
/dist

# Local proxy config for `make` (not committed; see .env.example)
/.env


/images

node_modules

crates/asd-dioxus/dist

.playwright-cli
# Superpowers workflow byproducts: specs, plans, and research written while
# working on a change. Kept on disk for whoever is working, out of the repo —
# the durable contracts live in docs/ proper.
/.superpowers/
/docs/superpowers/
